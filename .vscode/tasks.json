{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: cl.exe build active file (release /O2)",
            "command": "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul && cl.exe /nologo /EHsc /O2 /Zi /W4 /Fe:\"${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe\" /Fo:\"${workspaceFolder}\\build\\\\\" /Fd:\"${workspaceFolder}\\build\\${fileBasenameNoExtension}.pdb\" \"${file}\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Optimised build -- roughly 2x faster than the unoptimised one."
        },
        {
            "type": "shell",
            "label": "C/C++: cl.exe build active file (debug)",
            "command": "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\18\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul && cl.exe /nologo /EHsc /Od /Zi /W4 /Fe:\"${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe\" /Fo:\"${workspaceFolder}\\build\\\\\" /Fd:\"${workspaceFolder}\\build\\${fileBasenameNoExtension}.pdb\" \"${file}\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": "build",
            "detail": "Unoptimised, for stepping in the debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/nologo",
                "/EHsc",
                "/O2",
                "/fp:fast",
                "/arch:AVX2",
                "/openmp",
                "/std:c++17",
                "/Fe:",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}